{
  "version": 2,
  "buildCommand": "npm --prefix backend run build && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/cron/overdue",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
