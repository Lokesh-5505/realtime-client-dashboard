datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectsManaged Project[]      @relation("ProjectManager")
  assignedTasks   Task[]         @relation("AssignedDeveloper")
  activityLogs    ActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, tokenHash])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  company   String
  email     String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([managerId])
  @@index([clientId])
}

model Task {
  id           String     @id @default(uuid())
  taskNumber   Int        @default(autoincrement())
  title        String
  description  String?
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?      @relation("AssignedDeveloper", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isOverdue    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activityLogs ActivityLog[]

  @@index([projectId, status])
  @@index([assignedToId, status])
  @@index([dueDate, isOverdue])
  @@index([priority])
}

model ActivityLog {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  previousState String?
  newState      String?
  message       String
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}
